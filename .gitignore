# Credentials and local configuration
.env
.env.*
!.env.example
*credentials*
tokens/

# Local toolchain, environments and build output
.tools/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store

# Databases (including journals)
*.duckdb
*.duckdb.*
*.db
*.db-*
*.sqlite*

# Keep directory placeholders, never downloaded data or reports
data/raw/**
!data/raw/.gitkeep
data/curated/**
!data/curated/.gitkeep
data/warehouse/**
!data/warehouse/.gitkeep
reports/**
!reports/.gitkeep

# Public repository privacy boundary
data/private/**
private/**
